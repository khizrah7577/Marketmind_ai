# OpenAI API key (required). Never commit a real .env file.
# Copy this file to .env and paste your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional overrides — defaults live in src/config.py
OPENAI_BASE_URL=
# Per-stage models (use current docs; gpt-4o-mini is a safe default for cost)
MODEL_ANALYSER=gpt-4o-mini
MODEL_PLANNER=gpt-4o-mini
MODEL_RESEARCHER=gpt-4o-mini
MODEL_EVIDENCE=gpt-4o-mini
MODEL_COMPARISON=gpt-4o-mini
MODEL_SYNTHESIS=gpt-4o-mini
MODEL_QC=gpt-4o-mini
MODEL_REPORT=gpt-4o-mini

# Budgets and caps
MAX_ITERATIONS=25
MAX_TOOL_CALLS=60
MAX_REPAIR_ROUNDS=2
RUN_BUDGET_USD=2.00
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=4

# Logging
LOG_LEVEL=INFO
